# Configuration du futur serveur privé ; jamais dans VITE_* ni dans Electron.
# Le programme de diagnostic lit process.env, sans charger automatiquement ce fichier.
APP_MODE=demo

# --- API X : accès désactivé par défaut, aucun secret réel ---
X_API_ENABLED=false
X_API_BEARER_TOKEN=
# Origines HTTPS autorisées : api.x.com ou api.twitter.com, chemin /2 uniquement.
X_API_BASE_URL=https://api.x.com/2
# Redis du serveur, avec persistance ; jamais requis sur le PC de démonstration.
REDIS_URL=
# PostgreSQL privé migré à 0013 ; obligatoire avec Redis pour le mode réel.
# Rôle applicatif sans superuser/BYPASSRLS, TLS vérifié selon le déploiement.
DATABASE_URL=
# Même espace pour tous les workers d'un même compte de facturation.
X_CONTROL_NAMESPACE=default
# JSON contenant tous les chemins REST ; vide = chemins officiels vérifiés.
X_ENDPOINTS_CONFIG_PATH=
# Le SDK récent emploie parfois post.fields, les exemples historiques tweet.fields.
# À vérifier pour le compte et la version API avant activation ; aucun repli payant.
X_POST_FIELDS_PARAMETER=tweet.fields
# false interdit ; true ne prouve pas l'accès et reste « non testé » avant réponse.
X_CAPABILITY_RECENT=
X_CAPABILITY_ARCHIVE=
X_CAPABILITY_POSTS=
X_CAPABILITY_USERNAME=
X_CAPABILITY_USERS=
X_CAPABILITY_TIMELINE=
X_CAPABILITY_CONVERSATION=
X_CAPABILITY_QUOTES=
X_CAPABILITY_STREAM=
# Limites locales prudentes à adapter au contrat X, pas des quotas fournisseur.
X_MAX_RESULTS_PER_REQUEST=100
X_MAX_LOOKUP_IDS=100
X_QUERY_MAX_LENGTH=512
# Aucun opérateur avancé autorisé par défaut. Ex. après vérification : from,lang,conversation_id
X_ALLOWED_OPERATORS=
# Vide = fenêtre historique inconnue ; ne pas inventer un nombre de jours.
X_RECENT_WINDOW_SECONDS=
X_LOCAL_MIN_INTERVAL_MS=1000
X_MAX_RETRIES=2
X_RETRY_BASE_MS=500
X_RETRY_MAX_WAIT_MS=30000
X_TIMEOUT_MS=10000
X_CIRCUIT_FAILURES=3
X_CIRCUIT_COOLDOWN_MS=60000

# --- Budget X : montants entiers exacts en millionièmes de dollar USD ---
# Ces chemins restent vides tant que tarifs et plafonds n'ont pas été vérifiés.
# Copier config/x-pricing.example.json puis remplacer les null par le vrai tarif.
X_PRICING_CONFIG_PATH=
X_BUDGET_DAILY_MICRO_USD=
X_BUDGET_MONTHLY_MICRO_USD=
# JSON facultatif : {"watch":{"daily":"...","monthly":"..."},"people":{...},"conversations":{...}}
X_FEATURE_BUDGETS_PATH=
X_BUDGET_WARNING_PERCENT=80
# Le blocage au plafond est obligatoire, aucune option ne permet de le désactiver.

# --- Collecte X privée : désactivée par défaut ---
X_COLLECTION_MODE=disabled
# UUID de l’utilisateur authentifié propriétaire des règles ; jamais fourni par une URL publique.
X_OWNER_USER_ID=
X_POLL_INTERVAL_SECONDS_DEFAULT=300
X_POLL_INTERVAL_SECONDS_HIGH_PRIORITY=60
X_COLLECTION_MAX_PAGES=3
# Bail supérieur à fenêtre du flux + timeout + marge, validé avant démarrage du worker.
X_COLLECTION_LEASE_MS=120000
X_STREAM_MAX_RECONNECTS=3
# Chemins contrôlés et vérifiés dans le SDK officiel ; aucun repli automatique payant.
X_STREAM_PATH=/tweets/search/stream
X_STREAM_RULES_PATH=/tweets/search/stream/rules
# Bornes LOCALES, pas des quotas fournisseur présumés.
X_STREAM_MAX_RULES=10
X_STREAM_WINDOW_MS=60000
X_STREAM_IDLE_TIMEOUT_MS=30000
X_STREAM_MAX_POSTS=100
# Sans borne contractuelle de facturation vérifiée, pas de connexion REAL au flux.
# Une limite logicielle de trames ne prouve pas une limite de facturation fournisseur.
X_STREAM_BILLABLE_MAX_POSTS=
X_STREAM_BILLING_BOUND_VERIFIED=false

# --- Paramètres futurs, NON lus : conversations phase 5, graphique phase 8 ---
# X_CONVERSATION_MAX_POSTS=500
# X_CONVERSATION_CONFIRM_THRESHOLD=200
# Les anciens noms X_BUDGET_DAILY_LIMIT/MONTHLY_LIMIT ne sont pas acceptés :
# utiliser explicitement les unités MICRO_USD ci-dessus pour éviter toute ambiguïté.
# La rétention automatisée et les interfaces de ces étapes restent à livrer.

# --- API serveur indépendante de Windows, étape 3 ---
# Origine fixe ; aucun collecteur n’est activé par ce paramètre.
MEMERADAR_API_ORIGIN=REAL
MEMERADAR_API_PORT=8787
# Dev local seulement ; TLS obligatoire en production.
MEMERADAR_API_ALLOW_LOCAL_HTTP=false
MEMERADAR_API_PUBLIC_ORIGIN=
MEMERADAR_API_TLS_CERT_FILE=
MEMERADAR_API_TLS_KEY_FILE=
# Provisionnement via variables sécurisées serveur, jamais dans le chat.
# Supprimer ces deux variables après création du compte.
MEMERADAR_ADMIN_EMAIL=
MEMERADAR_ADMIN_PASSWORD=
